b:["$","p",null,{"children":"Pennsylvania's Keystone Biology exam has a persistently low passing rate, with an even wider gap in Title I schools. With no dedicated preparation tool, students relied on generic practice that rewarded memorization while teachers lacked visibility into where reasoning broke down."}]
c:["$","div",null,{"className":"problem-grid","children":[["$","article","01",{"children":[["$","span",null,{"children":"01"}],["$","h3",null,{"children":"No Keystone-specific tool"}],["$","p",null,{"children":"Students lacked practice designed around the exam's real format and standards."}]]}],["$","article","02",{"children":[["$","span",null,{"children":"02"}],["$","h3",null,{"children":"Memorization over reasoning"}],["$","p",null,{"children":"Students learned to pattern-match answers instead of explaining biological concepts."}]]}],["$","article","03",{"children":[["$","span",null,{"children":"03"}],["$","h3",null,{"children":"No teacher visibility"}],["$","p",null,{"children":"Teachers could see scores, but not misconceptions or who needed intervention."}]]}]]}]
