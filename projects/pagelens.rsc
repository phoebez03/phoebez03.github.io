d:["$","section",null,{"className":"case-section problem-section pagelens-problem","id":"problem","aria-labelledby":"pagelens-problem-heading","children":[["$","div",null,{"className":"case-section-intro split-intro","children":[["$","p",null,{"className":"case-section-label","children":"01 · Problem"}],["$","h2",null,{"id":"pagelens-problem-heading","children":["Physical books are fixed.",["$","br",null,{}],["$","em",null,{"children":"Readers are not."}]]}],["$","p",null,{"children":"Reading needs vary across people and moments, yet the printed page offers one permanent presentation. The opportunity was to preserve the tactile, focused experience of a physical book while giving readers meaningful control."}]]}],["$","div",null,{"className":"problem-grid","children":[["$","article","01",{"children":[["$","span",null,{"children":"01"}],["$","h3",null,{"children":"Fixed"}],["$","p",null,{"children":"Printed typography, spacing, and page layout cannot adapt to the needs of an individual reader."}]]}],["$","article","02",{"children":[["$","span",null,{"children":"02"}],["$","h3",null,{"children":"Disconnected"}],["$","p",null,{"children":"Reading support often moves people away from the physical book into a separate digital experience."}]]}],["$","article","03",{"children":[["$","span",null,{"children":"03"}],["$","h3",null,{"children":"Visible"}],["$","p",null,{"children":"Specialized assistive tools can single readers out instead of supporting them with dignity."}]]}]]}],["$","blockquote",null,{"className":"pagelens-hmw","children":[["$","span",null,{"children":"How might we"}]," preserve the physical reading experience while giving every reader more control?"]}]]}]
e:["$","section",null,{"className":"case-section process-section pagelens-process","id":"process","aria-labelledby":"pagelens-process-heading","children":[["$","div",null,{"className":"case-section-intro","children":[["$","p",null,{"className":"case-section-label","children":"02 · Process"}],["$","h2",null,{"id":"pagelens-process-heading","children":["From library context",["$","br",null,{}],["$","em",null,{"children":"to a feasible system."}]]}],["$","p",null,{"children":"We moved between human evidence and technical detail: observing the service context, mapping the experience, evaluating technology, and testing whether the whole concept could behave responsibly."}]]}],["$","div",null,{"className":"mvp-timeline pagelens-timeline","children":[["$","article","01",{"className":"mvp-card","tabIndex":0,"children":[["$","span",null,{"className":"mvp-number","children":["Stage ","01"]}],["$","h3",null,{"children":"Opportunity & research"}],["$","p",null,{"className":"mvp-keywords","children":"Site visit · Literature review"}],["$","p",null,{"className":"mvp-detail","children":"We studied the library context, reading barriers, and evidence around dyslexia-friendly support before defining a direction."}]]}],["$","article","02",{"className":"mvp-card","tabIndex":0,"children":[["$","span",null,{"className":"mvp-number","children":["Stage ","02"]}],["$","h3",null,{"children":"Technology exploration"}],["$","p",null,{"className":"mvp-keywords","children":"AR · OCR · Generative AI"}],["$","p",null,{"className":"mvp-detail","children":"We mapped what each technology could responsibly do, where it could fail, and which capabilities belonged on-device."}]]}],["$","article","03",{"className":"mvp-card","tabIndex":0,"children":[["$","span",null,{"className":"mvp-number","children":["Stage ","03"]}],["$","h3",null,{"children":"Experience mapping"}],["$","p",null,{"className":"mvp-keywords","children":"Journey · Service blueprint"}],["$","p",null,{"className":"mvp-detail","children":"We connected approaching the station, onboarding, reading support, and departure into one coherent service."}]]}],["$","article","04",{"className":"mvp-card","tabIndex":0,"children":[["$","span",null,{"className":"mvp-number","children":["Stage ","04"]}],["$","h3",null,{"children":"System feasibility"}],["$","p",null,{"className":"mvp-keywords","children":"Hardware · Interactions"}],["$","p",null,{"className":"mvp-detail","children":"A system diagram and hardware specification made the concept concrete enough to evaluate beyond the interface."}]]}],["$","article","05",{"className":"mvp-card","tabIndex":0,"children":[["$","span",null,{"className":"mvp-number","children":["Stage ","05"]}],["$","h3",null,{"children":"Responsible design"}],["$","p",null,{"className":"mvp-keywords","children":"Privacy · Stigma · Autonomy"}],["$","p",null,{"className":"mvp-detail","children":"We pressure-tested every feature against accessibility, dignity, data minimization, and reader control."}]]}]]}],["$","div",null,{"className":"pagelens-process-figures","children":[["$","figure",null,{"children":[["$","img",null,{"src":"/projects/pagelens/research/user-flow.png","alt":"PageLens four-stage user flow from approaching the station to leaving"}],["$","figcaption",null,{"children":[["$","span",null,{"children":"Experience model"}],["$","strong",null,{"children":"A coherent journey before individual screens."}]]}]]}],["$","figure",null,{"children":[["$","img",null,{"src":"/projects/pagelens/research/system-diagram.png","alt":"PageLens system diagram connecting camera, tablet, AI, hardware, and book"}],["$","figcaption",null,{"children":[["$","span",null,{"children":"Technical feasibility"}],["$","strong",null,{"children":"Five layers working as one reading station."}]]}]]}],["$","figure",null,{"className":"pagelens-system-figure","children":[["$","img",null,{"src":"/projects/pagelens/design-system.png","alt":"PageLens accessibility-focused color and typography design system"}],["$","figcaption",null,{"children":[["$","span",null,{"children":"Design system"}],["$","strong",null,{"children":"A flexible visual framework for readable choices."}]]}]]}]]}]]}]
f:["$","section",null,{"className":"case-section decisions-section pagelens-decisions","id":"decisions","aria-labelledby":"pagelens-decisions-heading","children":[["$","div",null,{"className":"case-section-intro","children":[["$","p",null,{"className":"case-section-label","children":"Key design decisions"}],["$","h2",null,{"id":"pagelens-decisions-heading","children":[["$","span",null,{"children":"Accessibility as control."}],["$","em",null,{"children":"Not a visual treatment."}]]}]]}],["$","div",null,{"className":"decision-list","children":[["$","article","01",{"className":"decision-block","children":[["$","div",null,{"className":"decision-copy","children":[["$","span",null,{"className":"decision-number","children":["Decision ","01"]}],["$","h3",null,{"children":"Design from evidence, not accessibility myths"}],["$","p",null,{"className":"decision-tags","children":"UX Research · Typography · Evidence-led design"}],["$","dl",null,{"children":[["$","div",null,{"children":[["$","dt",null,{"children":"Context"}],["$","dd",null,{"children":"Our early exploration included the common assumption that a specialized dyslexia font should be the foundation of the experience."}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Problem"}],["$","dd",null,{"children":"Research did not support treating one font as a universal solution. Readers benefit from different combinations of spacing, line length, contrast, and support."}]]}],["$","div",null,{"className":"decision-emphasis","children":[["$","dt",null,{"children":"Decision"}],["$","dd",null,{"children":"I shifted the design system toward customizable character spacing, shorter line lengths, clear hierarchy, and optional visual support—giving readers control instead of prescribing one answer."}]]}]]}]]}],["$","div",null,{"className":"decision-media pagelens-decision-media","children":[["$","span",null,{"children":"Design artifact"}],["$","figure",null,{"className":"decision-media-frame","children":["$","img",null,{"src":"/projects/pagelens/decision-01-settings.png","alt":"PageLens controls for text size, letter spacing, line height, and font style"}]}],["$","strong",null,{"children":"Reading settings that adapt to the individual"}]]}]]}],["$","article","02",{"className":"decision-block","children":[["$","div",null,{"className":"decision-copy","children":[["$","span",null,{"className":"decision-number","children":["Decision ","02"]}],["$","h3",null,{"children":"Offer capabilities, not a diagnosis"}],["$","p",null,{"className":"decision-tags","children":"Design Ethics · Progressive Disclosure · Accessibility"}],["$","dl",null,{"children":[["$","div",null,{"children":[["$","dt",null,{"children":"Context"}],["$","dd",null,{"children":"The concept needed to support people with varied reading needs without requiring them to disclose or accept a label."}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Problem"}],["$","dd",null,{"children":"A dedicated “Dyslexia Mode” would imply a single experience, expose sensitive information, and risk making the reader feel singled out."}]]}],["$","div",null,{"className":"decision-emphasis","children":[["$","dt",null,{"children":"Decision"}],["$","dd",null,{"children":"I organized support around what readers want to do: Easy to Read, Simplify Words, Read Aloud, and Bring Story to Life. Each tool stays optional and can be combined on the reader’s terms."}]]}]]}]]}],["$","div",null,{"className":"decision-media pagelens-decision-media","children":[["$","span",null,{"children":"Design artifact"}],["$","figure",null,{"className":"decision-media-frame","children":["$","img",null,{"src":"/projects/pagelens/research/support-features.png","alt":"PageLens screen offering four optional reading support features"}]}],["$","strong",null,{"children":"Support described through actions, not labels"}]]}]]}]]}]]}]
10:["$","section",null,{"className":"reflection-section pagelens-reflection","id":"reflection","aria-labelledby":"pagelens-reflection-heading","children":[["$","p",null,{"className":"case-section-label","children":"03 · Reflection"}],["$","h2",null,{"id":"pagelens-reflection-heading","children":["Accessible design supports",["$","br",null,{}],["$","em",null,{"children":"autonomy and dignity."}]]}],["$","p",null,{"children":"This project changed how I think about accessibility. The goal is not only to make content easier to read—it is to let people choose their support without being labeled, singled out, or asked to surrender privacy. Research moved us away from intuitive solutions and toward a flexible system readers could make their own."}],["$","div",null,{"children":[["$","span",null,{"children":"Evidence-led"}],["$","span",null,{"children":"Reader-controlled"}],["$","span",null,{"children":"Responsible by design"}]]}]]}]
