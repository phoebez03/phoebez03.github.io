f:["$","section",null,{"className":"case-section decisions-section pagelens-decisions","id":"decisions","aria-labelledby":"pagelens-decisions-heading","children":[["$","div",null,{"className":"case-section-intro","children":[["$","p",null,{"className":"case-section-label","children":"Key design decisions"}],["$","h2",null,{"id":"pagelens-decisions-heading","children":[["$","span",null,{"children":"Accessibility as control."}],["$","em",null,{"children":"Not a visual treatment."}]]}]]}],["$","div",null,{"className":"decision-list","children":[["$","article","01",{"className":"decision-block","children":[["$","div",null,{"className":"decision-copy","children":[["$","span",null,{"className":"decision-number","children":["Decision ","01"]}],["$","h3",null,{"children":"Design from evidence, not accessibility myths"}],["$","p",null,{"className":"decision-tags","children":"UX Research · Typography · Evidence-led design"}],["$","dl",null,{"children":[["$","div",null,{"children":[["$","dt",null,{"children":"Context"}],["$","dd",null,{"children":"Our early exploration included the common assumption that a specialized dyslexia font should be the foundation of the experience."}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Problem"}],["$","dd",null,{"children":"Research did not support treating one font as a universal solution. Readers benefit from different combinations of spacing, line length, contrast, and support."}]]}],["$","div",null,{"className":"decision-emphasis","children":[["$","dt",null,{"children":"Decision"}],["$","dd",null,{"children":"I shifted the design system toward customizable character spacing, shorter line lengths, clear hierarchy, and optional visual support—giving readers control instead of prescribing one answer."}]]}]]}]]}],["$","div",null,{"className":"decision-media pagelens-decision-media","children":[["$","span",null,{"children":"Design artifact"}],["$","figure",null,{"className":"decision-media-frame","children":["$","img",null,{"src":"/projects/pagelens/design/pagelens-accessibility-settings.png","alt":"PageLens controls for text size, letter spacing, line height, and font style"}]}],["$","strong",null,{"children":"Reading settings that adapt to the individual"}]]}]]}],["$","article","02",{"className":"decision-block","children":[["$","div",null,{"className":"decision-copy","children":[["$","span",null,{"className":"decision-number","children":["Decision ","02"]}],["$","h3",null,{"children":"Offer capabilities, not a diagnosis"}],["$","p",null,{"className":"decision-tags","children":"Design Ethics · Progressive Disclosure · Accessibility"}],["$","dl",null,{"children":[["$","div",null,{"children":[["$","dt",null,{"children":"Context"}],["$","dd",null,{"children":"The concept needed to support people with varied reading needs without requiring them to disclose or accept a label."}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Problem"}],["$","dd",null,{"children":"A dedicated “Dyslexia Mode” would imply a single experience, expose sensitive information, and risk making the reader feel singled out."}]]}],["$","div",null,{"className":"decision-emphasis","children":[["$","dt",null,{"children":"Decision"}],["$","dd",null,{"children":"I organized support around what readers want to do: Easy to Read, Simplify Words, Read Aloud, and Bring Story to Life. Each tool stays optional and can be combined on the reader’s terms."}]]}]]}]]}],["$","div",null,{"className":"decision-media pagelens-decision-media","children":[["$","span",null,{"children":"Design artifact"}],["$","figure",null,{"className":"decision-media-frame","children":["$","img",null,{"src":"/projects/pagelens/research/pagelens-support-features.png","alt":"PageLens screen offering four optional reading support features"}]}],["$","strong",null,{"children":"Support described through actions, not labels"}]]}]]}]]}]]}]
10:["$","section",null,{"className":"reflection-section pagelens-reflection","id":"reflection","aria-labelledby":"pagelens-reflection-heading","children":[["$","p",null,{"className":"case-section-label","children":"03 · Reflection"}],["$","h2",null,{"id":"pagelens-reflection-heading","children":["Accessible design supports",["$","br",null,{}],["$","em",null,{"children":"autonomy and dignity."}]]}],["$","p",null,{"children":"This project changed how I think about accessibility. The goal is not only to make content easier to read—it is to let people choose their support without being labeled, singled out, or asked to surrender privacy. Research moved us away from intuitive solutions and toward a flexible system readers could make their own."}],["$","div",null,{"children":[["$","span",null,{"children":"Evidence-led"}],["$","span",null,{"children":"Reader-controlled"}],["$","span",null,{"children":"Responsible by design"}]]}]]}]
