10:["$","section",null,{"className":"case-section problem-section impress-problem","id":"problem","aria-labelledby":"impress-problem-heading","children":[["$","div",null,{"className":"case-section-intro split-intro","children":[["$","p",null,{"className":"case-section-label","children":"01 · Problem"}],["$","h2",null,{"id":"impress-problem-heading","children":["Online art learning is passive.",["$","br",null,{}],["$","em",null,{"children":"Looking is an active skill."}]]}],["$","p",null,{"children":"Articles, videos, and static explanations deliver information, but they rarely help learners practice looking closely, interpreting visual evidence, and connecting observation to context."}]]}],["$","div",null,{"className":"problem-grid","children":[["$","article","01",{"children":[["$","span",null,{"children":"01"}],["$","h3",null,{"children":"Passive"}],["$","p",null,{"children":"Learners consume information instead of practicing the visual reasoning that art understanding requires."}]]}],["$","article","02",{"children":[["$","span",null,{"children":"02"}],["$","h3",null,{"children":"Content-heavy"}],["$","p",null,{"children":"Art history introduces unfamiliar terminology and historical context quickly, creating avoidable cognitive load."}]]}],["$","article","03",{"children":[["$","span",null,{"children":"03"}],["$","h3",null,{"children":"Low interaction"}],["$","p",null,{"children":"Learners get few chances to explain what they see, test an interpretation, or receive immediate feedback."}]]}]]}]]}]
11:["$","section",null,{"className":"case-section process-section impress-process","id":"process","aria-labelledby":"impress-process-heading","children":[["$","div",null,{"className":"case-section-intro","children":[["$","p",null,{"className":"case-section-label","children":"02 · Process"}],["$","h2",null,{"id":"impress-process-heading","children":["From learning goals",["$","br",null,{}],["$","em",null,{"children":"to interaction design."}]]}],["$","p",null,{"children":"Backward design kept the interface grounded in learning outcomes. Each round of prototyping and testing made the content more conversational, accessible, and usable for first-time learners."}]]}],["$","div",null,{"className":"mvp-timeline","children":[["$","article","01",{"className":"mvp-card","tabIndex":0,"children":[["$","span",null,{"className":"mvp-number","children":["Stage ","01"]}],["$","h3",null,{"children":"Backward design"}],["$","p",null,{"className":"mvp-keywords","children":"Learning science · Outcomes"}],["$","p",null,{"className":"mvp-detail","children":"I began with the abilities learners should leave with: close observation, interpretation, and evidence-based reasoning."}]]}],["$","article","02",{"className":"mvp-card","tabIndex":0,"children":[["$","span",null,{"className":"mvp-number","children":["Stage ","02"]}],["$","h3",null,{"children":"Learning objectives"}],["$","p",null,{"className":"mvp-keywords","children":"Curriculum · Scaffolding"}],["$","p",null,{"className":"mvp-detail","children":"Objectives became a sequence of foundation checks, terminology support, visual comparison, and application."}]]}],["$","article","03",{"className":"mvp-card","tabIndex":0,"children":[["$","span",null,{"className":"mvp-number","children":["Stage ","03"]}],["$","h3",null,{"children":"Dialogue first"}],["$","p",null,{"className":"mvp-keywords","children":"Low-fi · Conversation flow"}],["$","p",null,{"className":"mvp-detail","children":"Wireframes focused on message length, learner response, and feedback cadence before visual polish."}]]}],["$","article","04",{"className":"mvp-card","tabIndex":0,"children":[["$","span",null,{"className":"mvp-number","children":["Stage ","04"]}],["$","h3",null,{"children":"Think aloud"}],["$","p",null,{"className":"mvp-keywords","children":"Testing · Cognitive load"}],["$","p",null,{"className":"mvp-detail","children":"Observing first-time learners revealed where long messages and unfamiliar terms interrupted understanding."}]]}],["$","article","05",{"className":"mvp-card","tabIndex":0,"children":[["$","span",null,{"className":"mvp-number","children":["Stage ","05"]}],["$","h3",null,{"children":"Build & refine"}],["$","p",null,{"className":"mvp-keywords","children":"Figma Make · User testing"}],["$","p",null,{"className":"mvp-detail","children":"I built the interactive prototype, tested the complete experience, and refined pacing, hierarchy, and support."}]]}]]}]]}]
12:["$","section",null,{"className":"case-section decisions-section impress-decisions","id":"decisions","aria-labelledby":"impress-decisions-heading","children":[["$","div",null,{"className":"case-section-intro","children":[["$","p",null,{"className":"case-section-label","children":"Key design decisions"}],["$","h2",null,{"id":"impress-decisions-heading","children":["Less content at once.",["$","br",null,{}],["$","em",null,{"children":"More learning in motion."}]]}]]}],["$","div",null,{"className":"decision-list","children":[["$","article","01",{"className":"decision-block","children":[["$","div",null,{"className":"decision-copy","children":[["$","span",null,{"className":"decision-number","children":["Decision ","01"]}],["$","h3",null,{"children":"Design for conversation, not content delivery"}],["$","p",null,{"className":"decision-tags","children":"Interaction Design · Cognitive Load · Iteration"}],["$","dl",null,{"children":[["$","div",null,{"children":[["$","dt",null,{"children":"Context"}],["$","dd",null,{"children":"The chat interface needed to teach art concepts while still feeling conversational and lightweight."}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Problem"}],["$","dd",null,{"children":"Think-aloud testing showed that long instructional messages felt like a textbook placed inside chat bubbles."}]]}],["$","div",null,{"className":"decision-emphasis","children":[["$","dt",null,{"children":"Decision"}],["$","dd",null,{"children":"I broke the content into shorter, sequential message chunks and adjusted the pacing between them. Learners could scan the conversation and keep response options in view."}]]}]]}]]}],["$","div",null,{"className":"decision-media impress-decision-media","children":[["$","span",null,{"children":"Product screen"}],["$","figure",null,{"className":"decision-media-frame","children":["$","img",null,{"src":"/projects/impresschat/decision-01.png","alt":"Before and after comparison of the ImpressChat conversation design"}]}],["$","strong",null,{"children":"From dense instruction to paced dialogue"}]]}]]}],["$","article","02",{"className":"decision-block","children":[["$","div",null,{"className":"decision-copy","children":[["$","span",null,{"className":"decision-number","children":["Decision ","02"]}],["$","h3",null,{"children":"Keep support available without interrupting the flow"}],["$","p",null,{"className":"decision-tags","children":"Information Architecture · Progressive Disclosure · Accessibility"}],["$","dl",null,{"children":[["$","div",null,{"children":[["$","dt",null,{"children":"Context"}],["$","dd",null,{"children":"Art history relies on terms such as brushstroke, composition, and perspective that many first-time learners do not yet know."}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Problem"}],["$","dd",null,{"children":"Explaining every term inline made the mobile experience dense, while removing definitions risked leaving learners behind."}]]}],["$","div",null,{"className":"decision-emphasis","children":[["$","dt",null,{"children":"Decision"}],["$","dd",null,{"children":"I introduced essential vocabulary before the lesson, then highlighted unfamiliar terms in context with definitions available on demand."}]]}]]}]]}],["$","div",null,{"className":"decision-media impress-decision-media","children":[["$","span",null,{"children":"Product screen"}],["$","figure",null,{"className":"decision-media-frame","children":["$","img",null,{"src":"/projects/impresschat/showcase/instruction.png","alt":"ImpressChat conversation with highlighted art terminology and immediate feedback"}]}],["$","strong",null,{"children":"Support that appears at the moment of need"}]]}]]}]]}]]}]
13:["$","section",null,{"className":"reflection-section impress-reflection","id":"reflection","aria-labelledby":"impress-reflection-heading","children":[["$","p",null,{"className":"case-section-label","children":"03 · Reflection"}],["$","h2",null,{"id":"impress-reflection-heading","children":["Design beyond",["$","br",null,{}],["$","em",null,{"children":"my own understanding."}]]}],["$","p",null,{"children":"Concepts that felt obvious to me were not obvious to first-time learners. User testing exposed that expert blind spot and helped me rethink content density, terminology, and pacing. Good design came from observing the experience learners actually had—not the one I expected."}],["$","div",null,{"children":[["$","span",null,{"children":"Learning science"}],["$","span",null,{"children":"Conversational UX"}],["$","span",null,{"children":"Evidence-led iteration"}]]}]]}]
