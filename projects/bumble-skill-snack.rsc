c:["$","section",null,{"className":"case-section problem-section bumble-problem","id":"problem","aria-labelledby":"bumble-problem-heading","children":[["$","div",null,{"className":"case-section-intro split-intro","children":[["$","p",null,{"className":"case-section-label","children":"01 · Problem"}],["$","h2",null,{"id":"bumble-problem-heading","children":["The match happened.",["$","br",null,{}],["$","em",null,{"children":"The conversation didn't."}]]}],["$","p",null,{"children":"The issue was not necessarily match quality—it was activation. Users reached the hardest moment with no specific reason to speak, while a blank text field placed the entire social burden on them."}]]}],["$","div",null,{"className":"problem-grid","children":[["$","article","01",{"children":[["$","span",null,{"children":"01"}],["$","h3",null,{"children":"Matches stalled"}],["$","p",null,{"children":"People were successfully matching, but a meaningful portion never converted that match into a conversation."}]]}],["$","article","02",{"children":[["$","span",null,{"children":"02"}],["$","h3",null,{"children":"The blank-box burden"}],["$","p",null,{"children":"A blank message field asked users to invent a relevant, confident opening with no structure or shared starting point."}]]}],["$","article","03",{"children":[["$","span",null,{"children":"03"}],["$","h3",null,{"children":"One idea, three platforms"}],["$","p",null,{"children":"The feature needed to feel unmistakably Bumble while adapting to different interaction patterns on mobile and Apple Watch."}]]}]]}]]}]
d:["$","section",null,{"className":"case-section process-section","id":"process","aria-labelledby":"bumble-process-heading","children":[["$","div",null,{"className":"case-section-intro","children":[["$","p",null,{"className":"case-section-label","children":"02 · Process"}],["$","h2",null,{"id":"bumble-process-heading","children":["From architecture",["$","br",null,{}],["$","em",null,{"children":"to native interaction."}]]}],["$","p",null,{"children":"I moved from the underlying flow to the interaction model, then translated the feature across three platforms. Each phase reduced uncertainty before increasing fidelity."}]]}],["$","div",null,{"className":"mvp-timeline bumble-timeline","children":[["$","article","01",{"className":"mvp-card","tabIndex":0,"children":[["$","span",null,{"className":"mvp-number","children":["Stage ","01"]}],["$","h3",null,{"children":"Flow & architecture"}],["$","p",null,{"className":"mvp-keywords","children":"Low fidelity · IA · User flows"}],["$","p",null,{"className":"mvp-detail","children":"I mapped the end-to-end experience before touching visuals. The pivotal question was where Skill Snack could live in Bumble’s existing architecture without feeling bolted on."}]]}],["$","article","02",{"className":"mvp-card","tabIndex":0,"children":[["$","span",null,{"className":"mvp-number","children":["Stage ","02"]}],["$","h3",null,{"children":"Interaction model"}],["$","p",null,{"className":"mvp-keywords","children":"Mid fidelity · Prototyping · Tradeoffs"}],["$","p",null,{"className":"mvp-detail","children":"I compared swipe, select, and browse patterns. Browse won because it respected the user’s pace and made choosing a prompt feel intentional rather than gimmicky."}]]}],["$","article","03",{"className":"mvp-card","tabIndex":0,"children":[["$","span",null,{"className":"mvp-number","children":["Stage ","03"]}],["$","h3",null,{"children":"Three-platform system"}],["$","p",null,{"className":"mvp-keywords","children":"High fidelity · Design system · Native patterns"}],["$","p",null,{"className":"mvp-detail","children":"I built the feature to full fidelity for iOS, Android, and Apple Watch. The Watch forced every element to justify its existence: three actions, zero cognitive clutter."}]]}]]}],["$","figure",null,{"className":"bumble-platform-system","children":[["$","div",null,{"children":[["$","span",null,{"children":"Stage 03 · Platform translation"}],["$","strong",null,{"children":"One feature, native to both iOS and Android."}]]}],["$","img",null,{"src":"/projects/bumble-skill-snack/platform-system.png","alt":"Skill Snack photo verification flows compared across Android and iOS"}]]}]]}]
e:["$","section",null,{"className":"case-section decisions-section","id":"decisions","aria-labelledby":"bumble-decisions-heading","children":[["$","div",null,{"className":"case-section-intro","children":[["$","p",null,{"className":"case-section-label","children":"Key design decisions"}],["$","h2",null,{"id":"bumble-decisions-heading","children":["Novel in purpose.",["$","br",null,{}],["$","em",null,{"children":"Familiar in use."}]]}]]}],["$","div",null,{"className":"decision-list","children":[["$","article","01",{"className":"decision-block","children":[["$","div",null,{"className":"decision-copy","children":[["$","span",null,{"className":"decision-number","children":["Decision ","01"]}],["$","h3",null,{"children":"Keep the experience light, even as the system grows complex"}],["$","p",null,{"className":"decision-tags","children":"Product Thinking · Information Architecture · Prototyping"}],["$","dl",null,{"children":[["$","div",null,{"children":[["$","dt",null,{"children":"Context"}],["$","dd",null,{"children":"The feature introduced different paths and states across men and women, free and paid users, and three platforms."}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Problem"}],["$","dd",null,{"children":"Supporting every case risked making a simple conversation starter feel fragmented and difficult to understand."}]]}],["$","div",null,{"className":"decision-emphasis","children":[["$","dt",null,{"children":"Decision"}],["$","dd",null,{"children":"I mapped flows and wireframes before high-fidelity UI, then used rapid prototypes to explore edge cases. Simplifying the architecture first kept complexity in the system—not in the user experience."}]]}]]}]]}],["$","div",null,{"className":"decision-media bumble-decision-media","children":[["$","span",null,{"children":"Interaction walkthrough"}],["$","video",null,{"controls":true,"muted":true,"playsInline":true,"preload":"metadata","poster":"/projects/bumble-skill-snack/media/decision-01-poster.jpg","children":["$","source",null,{"src":"/projects/bumble-skill-snack/media/decision-01.mp4","type":"video/mp4"}]}],["$","strong",null,{"children":"A focused mobile path into conversation"}]]}]]}],["$","article","02",{"className":"decision-block","children":[["$","div",null,{"className":"decision-copy","children":[["$","span",null,{"className":"decision-number","children":["Decision ","02"]}],["$","h3",null,{"children":"Extend the design system instead of reinventing it"}],["$","p",null,{"className":"decision-tags","children":"Design System · Visual Hierarchy · Cross-platform Craft"}],["$","dl",null,{"children":[["$","div",null,{"children":[["$","dt",null,{"children":"Context"}],["$","dd",null,{"children":"Skill Snack needed a distinct purpose while still feeling immediately familiar inside Bumble."}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Problem"}],["$","dd",null,{"children":"Early, more expressive layouts made the feature look novel, but that novelty also introduced unnecessary learning and interaction friction."}]]}],["$","div",null,{"className":"decision-emphasis","children":[["$","dt",null,{"children":"Decision"}],["$","dd",null,{"children":"I treated Bumble’s typography, color, hierarchy, spacing, and component behavior as the foundation, extending existing patterns only where the new behavior required it."}]]}]]}]]}],["$","div",null,{"className":"decision-media bumble-decision-media","children":[["$","span",null,{"children":"Interaction walkthrough"}],["$","video",null,{"controls":true,"muted":true,"playsInline":true,"preload":"metadata","poster":"/projects/bumble-skill-snack/media/decision-02-poster.jpg","children":["$","source",null,{"src":"/projects/bumble-skill-snack/media/decision-02.mp4","type":"video/mp4"}]}],["$","strong",null,{"children":"A new feature built from familiar patterns"}]]}]]}]]}]]}]
f:["$","section",null,{"className":"reflection-section bumble-reflection","id":"reflection","aria-labelledby":"bumble-reflection-heading","children":[["$","p",null,{"className":"case-section-label","children":"03 · Reflection"}],["$","h2",null,{"id":"bumble-reflection-heading","children":["Think beyond the screen.",["$","br",null,{}],["$","em",null,{"children":"Design the ecosystem."}]]}],["$","p",null,{"children":"This project strengthened both my Figma craft and product thinking. I learned to introduce something new without ignoring the product around it: the problem framing, competitive landscape, user groups, architecture, design system, and platform behavior all shaped the interface."}],["$","div",null,{"children":[["$","span",null,{"children":"Cross-platform systems"}],["$","span",null,{"children":"High-fidelity craft"}],["$","span",null,{"children":"Product thinking"}]]}]]}]
